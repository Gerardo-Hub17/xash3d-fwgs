+// Here are some "manual" INLINE routines for doing floating point to integer conversions
+extern short new_cw, old_cw;
 
-#ifdef HAVE_SSE
-inline float M_max(float a, float b) {
-	return _mm_cvtss_f32(_mm_max_ss(_mm_load_ss(&a), _mm_load_ss(&b)));
-}
+typedef union DLONG {
