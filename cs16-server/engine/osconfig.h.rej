--- cs16-src/engine/osconfig.h
+++ cs16-server/engine/osconfig.h
@@ -65,6 +65,15 @@
 	#include <sys/types.h>
 	#include <sys/stat.h>
 	#include <io.h>
+#elif defined(GEKKO) // Nintendo Wii (devkitPPC / libogc): newlib no trae dlfcn, elf, link, mman, sysinfo...
+	#include <ctype.h>
+	#include <errno.h>
+	#include <fcntl.h>
+	#include <limits.h>
+	#include <sys/stat.h>
+	#include <sys/time.h>
+	#include <sys/types.h>
+	#include <unistd.h>
 #else // _WIN32
 	#include <arpa/inet.h>
 	#include <ctype.h>
@@ -161,16 +170,25 @@
 
 	#define FASTCALL
 	#define __FUNC__ __func__
+#ifdef GEKKO // atributos solo de x86: en PowerPC no existen
+	#define CDECL
+	#define STDCALL
+#else
 	#define CDECL __attribute__ ((cdecl))
 	#define STDCALL __attribute__ ((stdcall))
+#endif
 	#define HIDDEN __attribute__((visibility("hidden")))
 	#define FORCEINLINE inline
 	#define NOINLINE __attribute__((noinline))
 	#define ALIGN16 __attribute__((aligned(16)))
 	#define NORETURN __attribute__((noreturn))
+#ifdef GEKKO
+	#define FORCE_STACK_ALIGN
+#else
 	#define FORCE_STACK_ALIGN __attribute__((force_align_arg_pointer))
+#endif
 
-#if defined __INTEL_COMPILER
+#if defined __INTEL_COMPILER || defined GEKKO
 	#define FUNC_TARGET(x)
 
 	#define __builtin_bswap16 _bswap16
@@ -184,14 +202,23 @@
 	//inline int SOCKET_MSGLEN(SOCKET s, u_long& r) { return ioctl(s, FIONREAD, (int*)&r); }
 	typedef int SOCKET;
 	#define INVALID_SOCKET (SOCKET)(~0)
-	#define SOCKET_FIONBIO(s, m) ioctl(s, FIONBIO, (char*)&m)
-	#define SOCKET_MSGLEN(s, r) ioctl(s, FIONREAD, (char*)&r)
 	#define SIN_GET_ADDR(saddr, r) r = (saddr)->s_addr
 	#define SIN_SET_ADDR(saddr, r) (saddr)->s_addr = (r)
 	#define SOCKET_CLOSE(s) close(s)
 	#define SOCKET_AGAIN() (errno == EAGAIN)
 	#define SOCKET_ERROR -1
 
+#ifdef GEKKO
+	// Wii: sin ioctl/mmap de POSIX. El servidor no abre sockets propios (lo hace el motor).
+	inline int WSAGetLastError() { return errno; }
+
+	inline void* sys_allocmem(unsigned int size) {
+		return malloc(size);
+	}
+	inline void sys_freemem(void* ptr, unsigned int size) {
+		free(ptr);
+	}
+#else
 	inline int ioctlsocket(int fd, int cmd, unsigned int *argp) { return ioctl(fd, cmd, argp); }
 	inline int closesocket(int fd) { return close(fd); }
 	inline int WSAGetLastError() { return errno; }
@@ -202,6 +229,7 @@
 	inline void sys_freemem(void* ptr, unsigned int size) {
 		munmap(ptr, size);
 	}
+#endif
 
 	#define WSAENOPROTOOPT ENOPROTOOPT
 
