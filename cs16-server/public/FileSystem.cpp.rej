--- cs16-src/public/FileSystem.cpp
+++ cs16-server/public/FileSystem.cpp
@@ -31,6 +31,21 @@
 IFileSystem *g_pFileSystem = nullptr;
 CSysModule *g_pFileSystemModule = nullptr;
 
+#ifdef GEKKO
+// Wii: filesystem_stdio va enlazado dentro del ejecutable, su CreateInterface (VFileSystem009)
+// ya es visible. No se carga ningun modulo con dlopen.
+bool FileSystem_Init()
+{
+	g_pFileSystem = (IFileSystem *)CreateInterface(FILESYSTEM_INTERFACE_VERSION, nullptr);
+	return g_pFileSystem != nullptr;
+}
+
+void FileSystem_Shutdown()
+{
+	g_pFileSystem = nullptr;
+}
+#else
+
 bool FileSystem_Init()
 {
 	g_pFileSystemModule = Sys_LoadModule(STDIO_FILESYSTEM_LIB);
@@ -63,3 +78,4 @@ void FileSystem_Shutdown()
 		g_pFileSystemModule = nullptr;
 	}
 }
+#endif // GEKKO
